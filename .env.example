# Copy to .env for local builds (`npm run build && npm run serve`).
# In GitHub, add these as repository secrets instead (Settings → Secrets and variables → Actions).

# Secret iCal/ICS address of your work calendar (Outlook: Publish calendar → ICS link; Google: "Secret address in iCal format")
WORK_ICS_URL=
# Secret iCal/ICS address of your personal calendar
PERSONAL_ICS_URL=

# Optional: require a passcode to view the calendar (data is encrypted, not just hidden)
CALENDAR_PASSCODE=
# Optional: random string that makes the subscribable feed URL unguessable (required for a feed when a passcode is set)
FEED_TOKEN=

# Optional sync-back (block personal commitments in your work Google Calendar).
# Enable with "syncBack": { "enabled": true } in calendar.config.json. See README → "Sync-back".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Created by `npm run google:auth`
GOOGLE_REFRESH_TOKEN=
# Defaults to the signed-in account's primary calendar
WORK_CALENDAR_ID=
